# ==========================================
# NOV environment configuration
# Copy to .env and fill in. Never commit .env.
# ==========================================

# Public address of the site. Used for share links and WhatsApp/social previews.
# Local: http://localhost:3000. On Vercel it defaults to the project's domain; set it for a custom domain.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Store name shown in page titles and link previews.
NEXT_PUBLIC_APP_NAME="Tomevari"
# Support address shown to buyers.
NEXT_PUBLIC_SUPPORT_EMAIL=tomevari8@gmail.com

# PostgreSQL connection string (local, Supabase, Neon...).
# Supabase: Connect → "Transaction pooler" string (port 6543), with your database password filled in.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nov_dev?schema=public"
# Supabase only: Connect → "Session pooler" string (port 5432). Used to create the tables.
DIRECT_URL=""

# Signs the admin login cookie. At least 32 random characters; required in production.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# Owner (admin) login created by `npm run prisma:seed` (and on every Vercel deploy). Password: 8+ characters.
# Re-running the seed resets the owner's password to this value.
INITIAL_ADMIN_EMAIL=""
INITIAL_ADMIN_PASSWORD=""

# Local testing without gateway keys: "true" fakes a successful payment.
# Ignored when NODE_ENV=production. Leave empty once you use real (test or live) keys.
PAYMENT_SIMULATION=true

# Paystack (default gateway: Mobile Money + card, GHS). Use sk_test_... keys for test mode.
# Paystack signs webhooks with this secret key; webhook URL: <APP_URL>/api/webhooks/paystack
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=""
PAYSTACK_SECRET_KEY=""

# Flutterwave (optional second gateway). Webhook URL: <APP_URL>/api/webhooks/flutterwave
NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=""
FLUTTERWAVE_SECRET_KEY=""
FLUTTERWAVE_ENCRYPTION_KEY=""
# The "secret hash" you set in the Flutterwave dashboard (sent as verif-hash).
FLUTTERWAVE_WEBHOOK_SECRET_HASH=""

# Transactional email via Resend. Empty = emails are printed in the dev server console.
RESEND_API_KEY=""
EMAIL_FROM="Tomevari <noreply@example.com>"

# File storage: Supabase Storage. Cover images and the files buyers download go to a private
# bucket (created automatically). Supabase → Project Settings → API (or "API Keys").
SUPABASE_URL=""
# The secret / service_role key. Server-side only: never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=""
# Optional bucket name (default: tomevari).
SUPABASE_STORAGE_BUCKET=""

# Alternative: Vercel Blob (private store). Set automatically when a Blob store is connected on Vercel.
BLOB_READ_WRITE_TOKEN=""

# Alternative: Cloudflare R2 / S3 storage. With no storage configured, files go to local disk (development only).
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="nov-private-products"
R2_ENDPOINT=""
# Public domain serving R2 images (e.g. images.example.com); used for product images.
R2_PUBLIC_DOMAIN=""
