datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CUSTOMER
  SELLER
  ADMIN
  SUPER_ADMIN
}

enum ProductKind {
  PHYSICAL
  DIGITAL
}

enum FulfillmentStatus {
  UNFULFILLED
  PARTIALLY_FULFILLED
  FULFILLED
  CANCELLED
  RETURNED
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  RECEIVED
  RESTOCKED
  REFUNDED
  CANCELLED
}

enum StockMovementType {
  RESTOCK
  ORDER_RESERVATION
  ORDER_FULFILLMENT
  ORDER_CANCELLATION
  RETURN_RESTOCK
  MANUAL_ADJUSTMENT
  DAMAGE_LOSS
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUND_PENDING
  REFUNDED
  PARTIALLY_REFUNDED
  CHARGEBACK
}

enum TransactionStatus {
  INITIALIZED
  PENDING
  SUCCESSFUL
  FAILED
  ABANDONED
  REVERSED
}

enum EntitlementStatus {
  ACTIVE
  SUSPENDED
  REVOKED
  EXPIRED
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum ProductType {
  EBOOK
  COURSE
  TEMPLATE
  AUDIO
  VIDEO
  SOFTWARE
  GRAPHICS
  BUNDLE
  FASHION
  FOOTWEAR
  ELECTRONICS
  ACCESSORIES
  HOME
  BEAUTY
  PHYSICAL_GOOD
}

model User {
  id               String            @id @default(cuid())
  email            String            @unique
  passwordHash     String?
  name             String?
  role             Role              @default(CUSTOMER)
  emailVerified    DateTime?
  avatarUrl        String?
  twoFactorEnabled Boolean           @default(false)
  twoFactorSecret  String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  orders           Order[]
  entitlements     Entitlement[]
  downloads        Download[]
  reviews          Review[]
  auditLogs        AuditLog[]
  couponRedemptions CouponRedemption[]
  store            Store?
  returns          ReturnRequest[]

  @@index([email])
  @@index([role])
}

model VerificationToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@index([token])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@index([token])
}

model Store {
  id               String            @id @default(cuid())
  sellerId         String            @unique
  seller           User              @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  name             String
  slug             String            @unique
  description      String?
  logoUrl          String?
  bannerUrl        String?
  brandColor       String?           @default("#000000")
  policyShipping   String?
  policyReturns    String?
  isVerified       Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  products         Product[]
  orders           Order[]
  fulfillments     Fulfillment[]
  shippingProfiles ShippingProfile[]
  returns          ReturnRequest[]

  @@index([slug])
  @@index([sellerId])
}

model Product {
  id               String             @id @default(cuid())
  storeId          String?
  store            Store?             @relation(fields: [storeId], references: [id], onDelete: SetNull)
  title            String
  slug             String             @unique
  description      String
  shortDescription String?
  brand            String?
  productKind      ProductKind        @default(DIGITAL)
  coverImage       String?
  galleryImages    String[]           @default([])
  price            Decimal            @db.Decimal(10, 2)
  discountPrice    Decimal?           @db.Decimal(10, 2)
  currency         String             @default("USD")
  isPublished      Boolean            @default(false)
  isFeatured       Boolean            @default(false)
  productType      ProductType        @default(EBOOK)
  features         String[]           @default([])
  whatsIncluded    String[]           @default([])
  tags             String[]           @default([])
  licenseInfo      String?
  refundInfo       String?
  metadata         Json?
  
  // 3D Product Interactive Assets
  model3dUrl       String?
  model3dPoster    String?
  model3dConfig    Json?

  shippingProfileId String?
  shippingProfile   ShippingProfile? @relation(fields: [shippingProfileId], references: [id], onDelete: SetNull)

  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  files            ProductFile[]
  versions         ProductVersion[]
  categories       ProductCategory[]
  variants         ProductVariant[]
  images           ProductImage[]
  orderItems       OrderItem[]
  entitlements     Entitlement[]
  reviews          Review[]

  @@index([slug])
  @@index([storeId])
  @@index([productKind])
  @@index([isPublished])
  @@index([isFeatured])
}

model ProductImage {
  id               String          @id @default(cuid())
  productId        String
  product          Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  url              String
  altText          String?
  displayOrder     Int             @default(0)
  isCover          Boolean         @default(false)
  createdAt        DateTime        @default(now())

  @@index([productId])
}

model ProductVariant {
  id                String          @id @default(cuid())
  productId         String
  product           Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku               String          @unique
  title             String
  option1Name       String?
  option1Value      String?
  option2Name       String?
  option2Value      String?
  option3Name       String?
  option3Value      String?
  price             Decimal         @db.Decimal(10, 2)
  salePrice         Decimal?        @db.Decimal(10, 2)
  costPrice         Decimal?        @db.Decimal(10, 2)
  weightGrams       Decimal?        @db.Decimal(10, 2)
  dimensions        Json?
  inventoryQuantity Int             @default(0)
  reservedQuantity  Int             @default(0)
  soldQuantity      Int             @default(0)
  barcode           String?
  imageUrl          String?
  isAvailable       Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  stockMovements    StockMovement[]
  orderItems        OrderItem[]
  reservations      InventoryReservation[]

  @@index([productId])
  @@index([sku])
}

model InventoryReservation {
  id               String          @id @default(cuid())
  variantId        String
  variant          ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity         Int
  orderId          String?
  sessionId        String?
  expiresAt        DateTime
  isReleased       Boolean         @default(false)
  createdAt        DateTime        @default(now())

  @@index([variantId])
  @@index([orderId])
  @@index([sessionId])
  @@index([expiresAt])
}

model StockMovement {
  id               String            @id @default(cuid())
  variantId        String
  variant          ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Cascade)
  movementType     StockMovementType
  quantityChanged  Int
  quantityBefore   Int
  quantityAfter    Int
  referenceId      String?
  note             String?
  performedBy      String?
  createdAt        DateTime          @default(now())

  @@index([variantId])
  @@index([movementType])
  @@index([createdAt])
}

model ShippingProfile {
  id                 String          @id @default(cuid())
  storeId            String?
  store              Store?          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name               String
  isDefault          Boolean         @default(false)
  processingTimeDays Int             @default(1)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  zones              ShippingZone[]
  products           Product[]

  @@index([storeId])
}

model ShippingZone {
  id                    String          @id @default(cuid())
  profileId             String
  profile               ShippingProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name                  String
  countries             String[]        @default([])
  baseRate              Decimal         @db.Decimal(10, 2)
  perItemRate           Decimal         @default(0) @db.Decimal(10, 2)
  freeShippingThreshold Decimal?        @db.Decimal(10, 2)
  estimatedDaysMin      Int             @default(2)
  estimatedDaysMax      Int             @default(5)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@index([profileId])
}

model ProductFile {
  id               String          @id @default(cuid())
  productId        String
  product          Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  fileName         String
  fileKey          String
  fileSize         BigInt
  fileType         String
  versionNumber    String          @default("1.0.0")
  isPrimary        Boolean         @default(true)
  maxDownloads     Int?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  downloads        Download[]

  @@index([productId])
  @@index([fileKey])
}

model ProductVersion {
  id               String          @id @default(cuid())
  productId        String
  product          Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  versionNumber    String
  changelog        String?
  releasedAt       DateTime        @default(now())
  createdAt        DateTime        @default(now())

  @@unique([productId, versionNumber])
  @@index([productId])
}

model Category {
  id               String            @id @default(cuid())
  name             String
  slug             String            @unique
  description      String?
  icon             String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  products         ProductCategory[]

  @@index([slug])
}

model ProductCategory {
  productId        String
  categoryId       String
  product          Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  category         Category        @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([productId])
  @@index([categoryId])
}

model Order {
  id                String            @id @default(cuid())
  orderNumber       String            @unique
  customerId        String?
  customer          User?             @relation(fields: [customerId], references: [id], onDelete: SetNull)
  storeId           String?
  store             Store?            @relation(fields: [storeId], references: [id], onDelete: SetNull)
  guestEmail        String?
  guestName         String?
  status            OrderStatus       @default(PENDING)
  fulfillmentStatus FulfillmentStatus @default(UNFULFILLED)
  subtotal          Decimal           @db.Decimal(10, 2)
  discountTotal     Decimal           @default(0) @db.Decimal(10, 2)
  shippingFee       Decimal           @default(0) @db.Decimal(10, 2)
  taxTotal          Decimal           @default(0) @db.Decimal(10, 2)
  total             Decimal           @db.Decimal(10, 2)
  currency          String            @default("USD")
  paymentProvider   String?
  shippingMethod    String?
  shippingAddress   Json?
  billingAddress    Json?
  customerNotes     String?
  utmSource         String?
  utmMedium         String?
  utmCampaign       String?
  utmContent        String?
  utmTerm           String?
  paidAt            DateTime?
  cancelledAt       DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  items             OrderItem[]
  transactions      Transaction[]
  entitlements      Entitlement[]
  couponRedemptions CouponRedemption[]
  refunds           Refund[]
  fulfillments      Fulfillment[]
  returns           ReturnRequest[]

  @@index([orderNumber])
  @@index([customerId])
  @@index([storeId])
  @@index([guestEmail])
  @@index([status])
  @@index([fulfillmentStatus])
}

model OrderItem {
  id                String            @id @default(cuid())
  orderId           String
  order             Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId         String
  product           Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantId         String?
  variant           ProductVariant?   @relation(fields: [variantId], references: [id], onDelete: SetNull)
  fulfillmentId     String?
  fulfillment       Fulfillment?      @relation(fields: [fulfillmentId], references: [id], onDelete: SetNull)
  productKind       ProductKind       @default(DIGITAL)
  sku               String?
  quantity          Int               @default(1)
  unitPrice         Decimal           @db.Decimal(10, 2)
  discountAmount    Decimal           @default(0) @db.Decimal(10, 2)
  totalPrice        Decimal           @db.Decimal(10, 2)
  fulfillmentStatus FulfillmentStatus @default(UNFULFILLED)
  productVersionId  String?
  createdAt         DateTime          @default(now())

  returns           ReturnRequest[]

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
  @@index([fulfillmentId])
}

model Fulfillment {
  id               String            @id @default(cuid())
  orderId          String
  order            Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  storeId          String?
  store            Store?            @relation(fields: [storeId], references: [id], onDelete: SetNull)
  status           FulfillmentStatus @default(UNFULFILLED)
  trackingNumber   String?
  trackingCarrier  String?
  trackingUrl      String?
  dispatchedAt     DateTime?
  deliveredAt      DateTime?
  notes            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  items            OrderItem[]

  @@index([orderId])
  @@index([storeId])
  @@index([status])
}

model ReturnRequest {
  id                   String       @id @default(cuid())
  orderId              String
  order                Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItemId          String
  orderItem            OrderItem    @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  customerId           String
  customer             User         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  storeId              String?
  store                Store?       @relation(fields: [storeId], references: [id], onDelete: SetNull)
  status               ReturnStatus @default(REQUESTED)
  reason               String
  customerComment      String?
  sellerResponse       String?
  returnTrackingNumber String?
  refundAmount         Decimal?     @db.Decimal(10, 2)
  isRestocked          Boolean      @default(false)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@index([orderId])
  @@index([orderItemId])
  @@index([customerId])
  @@index([storeId])
  @@index([status])
}

model Transaction {
  id               String             @id @default(cuid())
  orderId          String
  order            Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider         String
  transactionRef   String             @unique
  providerRef      String?
  amount           Decimal            @db.Decimal(10, 2)
  currency         String
  status           TransactionStatus  @default(INITIALIZED)
  paymentMethod    String?
  feeAmount        Decimal?           @db.Decimal(10, 2)
  rawPayload       Json?
  errorMessage     String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  refunds          Refund[]

  @@index([orderId])
  @@index([transactionRef])
  @@index([providerRef])
  @@index([status])
}

model Entitlement {
  id               String             @id @default(cuid())
  customerId       String
  customer         User               @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orderId          String
  order            Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId        String
  product          Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  status           EntitlementStatus  @default(ACTIVE)
  grantedAt        DateTime           @default(now())
  revokedAt        DateTime?
  revokeReason     String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  downloads        Download[]

  @@unique([customerId, productId])
  @@index([customerId])
  @@index([productId])
  @@index([status])
}

model Download {
  id               String          @id @default(cuid())
  entitlementId    String
  entitlement      Entitlement     @relation(fields: [entitlementId], references: [id], onDelete: Cascade)
  productFileId    String
  productFile      ProductFile     @relation(fields: [productFileId], references: [id], onDelete: Restrict)
  customerId       String
  customer         User            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  ipAddress        String?
  userAgent        String?
  downloadedAt     DateTime        @default(now())

  @@index([entitlementId])
  @@index([productFileId])
  @@index([customerId])
  @@index([downloadedAt])
}

model Coupon {
  id               String            @id @default(cuid())
  code             String            @unique
  description      String?
  discountType     DiscountType      @default(PERCENTAGE)
  discountValue    Decimal           @db.Decimal(10, 2)
  minOrderAmount   Decimal?          @db.Decimal(10, 2)
  maxUses          Int?
  usedCount        Int               @default(0)
  perCustomerLimit Int               @default(1)
  startsAt         DateTime          @default(now())
  expiresAt        DateTime?
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  redemptions      CouponRedemption[]

  @@index([code])
  @@index([isActive])
}

model CouponRedemption {
  id               String          @id @default(cuid())
  couponId         String
  coupon           Coupon          @relation(fields: [couponId], references: [id], onDelete: Cascade)
  orderId          String
  order            Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerId       String?
  customer         User?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  discountAmount   Decimal         @db.Decimal(10, 2)
  redeemedAt       DateTime        @default(now())

  @@index([couponId])
  @@index([orderId])
  @@index([customerId])
}

model Review {
  id                 String        @id @default(cuid())
  productId          String
  product            Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerId         String
  customer           User          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  rating             Int
  title              String?
  comment            String
  isVerifiedPurchase Boolean       @default(false)
  isApproved         Boolean       @default(true)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([productId])
  @@index([customerId])
  @@index([rating])
}

model AuditLog {
  id               String          @id @default(cuid())
  userId           String?
  user             User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  action           String
  entityType       String
  entityId         String?
  oldValue         Json?
  newValue         Json?
  ipAddress        String?
  userAgent        String?
  createdAt        DateTime        @default(now())

  @@index([userId])
  @@index([action])
  @@index([entityType])
  @@index([createdAt])
}

model NewsletterSubscriber {
  id               String          @id @default(cuid())
  email            String          @unique
  isActive         Boolean         @default(true)
  subscribedAt     DateTime        @default(now())

  @@index([email])
}

model AnalyticsEvent {
  id               String          @id @default(cuid())
  eventName        String
  userId           String?
  sessionId        String?
  properties       Json?
  ipAddress        String?
  userAgent        String?
  createdAt        DateTime        @default(now())

  @@index([eventName])
  @@index([userId])
  @@index([sessionId])
  @@index([createdAt])
}

model PaymentWebhookEvent {
  id               String          @id @default(cuid())
  provider         String
  eventType        String
  eventId          String?
  payload          Json
  isProcessed      Boolean         @default(false)
  processedAt      DateTime?
  error            String?
  createdAt        DateTime        @default(now())

  @@index([provider])
  @@index([eventType])
  @@index([isProcessed])
}

model Refund {
  id               String          @id @default(cuid())
  orderId          String
  order            Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  transactionId    String?
  transaction      Transaction?    @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  amount           Decimal         @db.Decimal(10, 2)
  currency         String
  status           String          @default("COMPLETED")
  reason           String?
  requestedBy      String?
  approvedBy       String?
  processedAt      DateTime        @default(now())
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([orderId])
  @@index([transactionId])
}
